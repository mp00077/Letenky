QWidget { font-family: "Segoe UI", "Noto Sans", sans-serif; font-size: 13px; color: #233c39; }
QMainWindow, QDialog { background: #f5f6f0; }
QLabel#eyebrow { color: #5d756d; font-size: 11px; font-weight: 700; }
QLabel#heading { font-size: 27px; font-weight: 700; color: #153e38; }
QLabel#subtitle, QLabel#sourceLabel, QLabel#chartNote { color: #5c6f68; }
QLabel#summaryLabel { background: #e6eddf; border-radius: 8px; padding: 14px; font-weight: 600; }
QLabel#emptyLabel { color: #64786e; font-size: 16px; }
QPushButton { background: white; border: 1px solid #c9d4ca; border-radius: 6px; padding: 9px 14px; font-weight: 600; }
QPushButton:hover { background: #e8eee3; border-color: #7f9c8b; }
QPushButton:disabled { color: #8a958e; background: #edf0e8; }
QPushButton#addButton, QPushButton#searchButton { color: #f6f9ee; background: #173e3a; border-color: #173e3a; }
QPushButton#addButton:hover, QPushButton#searchButton:hover { background: #27564c; }
QTableView, QListWidget { background: white; alternate-background-color: #f5f8f1; border: 1px solid #d5ded2; border-radius: 6px; selection-background-color: #dcebbd; selection-color: #173e3a; }
QTableView::item { padding: 8px; border: none; }
QHeaderView::section { background: #eaf0e3; color: #45604f; padding: 11px 8px; border: none; border-bottom: 1px solid #d5ded2; font-weight: 600; }
QComboBox, QDateEdit { background: white; border: 1px solid #c9d4ca; border-radius: 5px; padding: 7px; min-height: 20px; }
QComboBox QAbstractItemView { background: white; selection-background-color: #dcebbd; selection-color: #173e3a; }
QStatusBar { background: #eaf0e3; color: #536956; }
QToolTip { background: #173e3a; color: white; border: none; padding: 8px; }
